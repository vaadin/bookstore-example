<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.vaadin</groupId>
    <artifactId>bookstore-example-loadtest</artifactId>
    <packaging>pom</packaging>
    <version>1.0-SNAPSHOT</version>
    <name>bookstore-example-loadtest</name>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>

        <testbench.version>10.2.0-alpha5</testbench.version>

        <!-- Local server configuration -->
        <management.port>8082</management.port>

        <!-- Remote server configuration -->
        <k6.appHost>localhost</k6.appHost>
        <k6.appPort>8080</k6.appPort>

        <!-- K6 test configuration -->
        <k6.vus>10</k6.vus>
        <k6.duration>5s</k6.duration>
        <k6.testDir>${project.basedir}/../target/k6/tests</k6.testDir>

        <!-- Combined scenario weights (percentage of VUs for each scenario) -->
        <k6.combineScenarios>true</k6.combineScenarios>
        <k6.scenarioWeights>aboutView:25,sampleCrudView:50,loginScreen:25</k6.scenarioWeights>

        <!-- Enable Vaadin-specific metrics collection (requires VaadinActuator in demo app) -->
        <k6.collectVaadinMetrics>true</k6.collectVaadinMetrics>
    </properties>

    <pluginRepositories>
        <pluginRepository>
            <id>vaadin-prereleases</id>
            <url>https://maven.vaadin.com/vaadin-prereleases</url>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>

    <!--
            Production Load Testing
            - Does NOT start any server (assumes server is running elsewhere)
            - Runs pre-recorded k6 tests against a configurable remote target
            - Designed to run from a dedicated load generation machine

            Usage:
              mvn verify -Dk6.appHost=staging.example.com
              mvn verify -Dk6.appHost=10.0.1.50 -Dk6.appPort=8080 -Dk6.vus=100 -Dk6.duration=5m
        -->
    <build>
        <plugins>
            <!-- Validate remote server is accessible -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check-remote-server</id>
                        <phase>pre-integration-test</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <echo message="=============================================="/>
                                <echo message="Remote Load Test Configuration"/>
                                <echo message="=============================================="/>
                                <echo message="  Target:   http://${k6.appHost}:${k6.appPort}"/>
                                <echo message="  Tests:    ${k6.testDir}"/>
                                <echo message="  VUs:      ${k6.vus}"/>
                                <echo message="  Duration: ${k6.duration}"/>
                                <echo message="=============================================="/>
                                <echo message="Checking if remote server is accessible..."/>
                                <condition property="remote.up">
                                    <http url="http://${k6.appHost}:${k6.appPort}"
                                          errorsBeginAt="500"/>
                                </condition>
                                <fail unless="remote.up"
                                      message="ERROR: Cannot reach http://${k6.appHost}:${k6.appPort} - make sure the application is running on the target server."/>
                                <echo message="Remote server is accessible!"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- K6 load tests against remote server -->
            <plugin>
                <groupId>com.vaadin</groupId>
                <artifactId>testbench-converter-plugin</artifactId>
                <version>${testbench.version}</version>
                <executions>
                    <execution>
                        <id>run-remote-load-tests</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <testDir>${k6.testDir}</testDir>
                            <virtualUsers>${k6.vus}</virtualUsers>
                            <duration>${k6.duration}</duration>
                            <appIp>${k6.appHost}</appIp>
                            <appPort>${k6.appPort}</appPort>
                            <managementPort>${management.port}</managementPort>
                            <combineScenarios>${k6.combineScenarios}</combineScenarios>
                            <scenarioWeights>${k6.scenarioWeights}</scenarioWeights>
                            <collectVaadinMetrics>${k6.collectVaadinMetrics}</collectVaadinMetrics>
                            <httpReqDurationP99>2000</httpReqDurationP99>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
